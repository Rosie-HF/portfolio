---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details>
  <summary class="hover:bg-primary-50 px-4 -mx-4 border-t-2 border-primary-100 py-4 cursor-pointer text-[length:var(--font-size-title)] font-medium leading-snug">{ title }</summary>
  <div class="faq-content prose max-w-none pb-5 text-[length:var(--font-size-ui)] leading-relaxed">
    <slot />
  </div>
</details>

<style is:inline>
details {
  overflow: hidden;
}

details::details-content {
  height: 0;
  transition: height 0.3s, content-visibility 0.3s;
  transition-behavior: allow-discrete;
}

details[open]::details-content {
  height: auto;
}

.faq-content :global(p) {
  max-width: 96ch;
}

.faq-content :global(ul) {
  max-width: 104ch;
}
</style>
