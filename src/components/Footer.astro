---
import { getEntry } from 'astro:content';
import { defaultLocale, useTranslations, getLocalePath, type LanguageKey } from '@/i18n/i18n.ts';
import DOMPurify from 'isomorphic-dompurify';

const config = await getEntry('config', 'site');
const { website } = config!.data;
const t = useTranslations(Astro.currentLocale as LanguageKey);
const copyrightHtml = t('Footer-Copyright', {
  year: `${new Date().getFullYear()}`,
  name: website.name,
  themeLink: `<a class="underline" href="https://github.com/riceball-tw/letter">Letter</a>`,
});

function getSocialLabel(name: string, url: string) {
  if (url.startsWith('mailto:')) return t('Contact-Email');
  if (url.startsWith('tel:')) return t('Contact-Phone');
  return name;
}

function getSocialValue(url: string) {
  return url.replace(/^mailto:/, '').replace(/^tel:/, '').replace(/^https?:\/\//, '').replace(/\/$/, '');
}
---

<footer class="print:hidden container mx-auto px-4 pt-4 pb-8 text-[length:var(--font-size-ui)]">
  <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
    <h2 class="max-w-5xl text-[length:var(--font-size-title)] leading-tight">
      <span class="font-bold">{t('Footer-1')}</span>
      <span class="text-primary-700">
        <br />
        {t('Footer-2')} <button class="cursor-pointer highlight" data-mail-btn={website.email}>{t('Contact-Email')}</button> {t('Footer-3')} <a class="highlight" href={getLocalePath(Astro.currentLocale as LanguageKey || defaultLocale, '/resume')}>{t('Footer-4')}</a> {t('Footer-5')}
      </span>
    </h2>

    <div class="rounded-xl border border-primary-200 bg-white/70 px-4 py-3 text-right shadow-sm backdrop-blur">
      <h3 class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Footer-6')}</h3>
      <ul class="mt-2 flex flex-col items-end gap-1">
        {
          website.socials.map((social) => (
            <li>
              <a class="inline-flex flex-wrap justify-end gap-x-2 rounded-md px-2 py-1 text-[length:var(--font-size-caption)] leading-snug transition-colors hover:bg-primary-100" href={social.url} target="_blank">
                <span class="font-semibold text-primary-900">{getSocialLabel(social.name, social.url)}</span>
                <span class="text-primary-700">{getSocialValue(social.url)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-primary-200 pt-4 text-[length:var(--font-size-caption)] text-primary-600">
    <p class="opacity-80" set:html={DOMPurify.sanitize(copyrightHtml)} />
    <span>{t('Website-Status')}</span>
  </div>
</footer>

<script is:inline define:vars={{ popoverText: t('Footer-7') }}>
  document.addEventListener('astro:page-load', () => {
    const mailButton = document.querySelector('[data-mail-btn]');
    if (!mailButton) return;

    mailButton.addEventListener('click', (e) => {
      navigator.clipboard.writeText(e.target.dataset.mailBtn);

      function showPopover(targetElement) {
        const popover = document.createElement('div');
        popover.textContent = popoverText;
        popover.style.position = 'absolute';
        popover.style.fontSize = '1rem';
        popover.style.letterSpacing = '0.05rem';
        popover.style.whiteSpace = 'nowrap';
        popover.style.left = '50%';
        popover.style.transform = 'translate(-50%, 0%)';

        targetElement.setAttribute('disabled', 'true');
        targetElement.appendChild(popover);

        setTimeout(() => {
          targetElement.removeChild(popover);
          targetElement.removeAttribute('disabled');
        }, 1000);
      }

      showPopover(e.target);
    });
  });
</script>
