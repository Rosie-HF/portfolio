---
import Base from '@/layouts/Base.astro';
import Banner from '@/components/Banner.astro';
import { languages, useTranslations, defaultLocale, getLocalePath, type LanguageKey } from '@/i18n/i18n.ts';
import { getCollection, getEntry } from 'astro:content';
import DOMPurify from 'isomorphic-dompurify';
import { getTechLabel } from '@/utils/tech.ts';
import { Icon } from 'astro-icon/components';

const currentLocale = Astro.currentLocale as LanguageKey;
const resume = (await getEntry('resume', currentLocale))?.data;
const publicCurrentLangProjects = await getCollection('project', (project) => {
  const isPublicProject = !project.data.draft;
  const isCurrentLangProject = project.id.startsWith(currentLocale);
  return isPublicProject && isCurrentLangProject;
});
const featuredProjects = publicCurrentLangProjects
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
const t = useTranslations(currentLocale);
const displayName = t('Person-Name');
const spotlightKeys = [
  'Home-Spotlight-1',
  'Home-Spotlight-2',
  'Home-Spotlight-3',
  'Home-Spotlight-4',
  'Home-Spotlight-5',
  'Home-Spotlight-6',
] as const;
const outputLinks = [
  {
    title: t('Home-Outputs-1-Title'),
    description: t('Home-Outputs-1-Description'),
    url: 'https://www.nature.com/articles/s41380-025-03132-8',
  },
  {
    title: t('Home-Outputs-2-Title'),
    description: t('Home-Outputs-2-Description'),
    url: 'https://iopscience.iop.org/article/10.1088/1742-6596/3147/1/012009',
  },
  {
    title: t('Home-Outputs-3-Title'),
    description: t('Home-Outputs-3-Description'),
    url: 'https://osf.io/k5sg6/overview',
  },
];

export function getStaticPaths() {
  return Object.keys(languages).map((language) => ({
    params: { language },
  }));
}
---

<Base title={t('Navbar-1')}>
  <main class="md:min-h-screen min-h-auto">
    <Banner>
      <div class="px-4 grid gap-6 lg:grid-cols-[1.45fr_0.85fr] items-start">
        <div class="space-y-5 lg:pr-6">
            <p class="uppercase tracking-[0.14em] text-[length:var(--font-size-label)] text-primary-600">{t('Home-Eyebrow')}</p>
            <h1 class="text-[length:var(--font-size-display)] font-semibold leading-none">
              {t('Hero-Greeting', { name: displayName })}
            </h1>
            <p class="max-w-4xl text-[length:var(--font-size-title)] leading-relaxed text-primary-700">
              {t('Hero-Intro')}
            </p>
            <p class="max-w-3xl text-[length:var(--font-size-ui)] leading-relaxed text-primary-600">
              <Fragment
                set:html={DOMPurify.sanitize(
                  t('Hero-CTA', {
                    articlesLink: `<a class="highlight" href="${getLocalePath(Astro.currentLocale as LanguageKey || defaultLocale, '/work')}">${t('Hero-BlogLink')}</a>`,
                    resumeLink: `<a class="highlight" href="${getLocalePath(Astro.currentLocale as LanguageKey || defaultLocale, '/resume')}">${t('Hero-Resume')}</a>`,
                  }),
                )}
              />
            </p>
        </div>

        <div class="h-full">
          <div class="h-full rounded-2xl bg-primary-900 text-primary-50 p-5 md:p-6">
            <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-300">{t('Home-Spotlight-Label')}</p>
            <ul class="mt-5 space-y-2.5 text-[length:var(--font-size-ui)] leading-relaxed">
              {spotlightKeys.map((key) => (
                <li>{t(key)}</li>
              ))}
            </ul>
          </div>
        </div>

        {resume && (
          <div class="h-full rounded-2xl border border-primary-200 bg-white/80 p-5 md:p-6 shadow-[0_20px_60px_rgba(41,74,72,0.08)] backdrop-blur">
            <div class="grid h-full gap-4 md:grid-cols-3">
              <div class="flex flex-col justify-start">
                <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Summary-1-Label')}</p>
                <p class="mt-2 text-[length:var(--font-size-ui)] font-medium leading-snug">{t('Home-Summary-1-Value')}</p>
              </div>
              <div class="flex flex-col justify-start">
                <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Summary-2-Label')}</p>
                <p class="mt-2 text-[length:var(--font-size-ui)] font-medium leading-snug">{t('Home-Summary-2-Value')}</p>
              </div>
              <div class="flex flex-col justify-start">
                <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Summary-3-Label')}</p>
                <p class="mt-2 text-[length:var(--font-size-ui)] font-medium leading-snug">{t('Home-Summary-3-Value')}</p>
              </div>
            </div>
          </div>
        )}

        <div class="h-full">
          <div class="h-full rounded-2xl border border-primary-200 bg-[#f7f1e8] p-5 md:p-6">
            <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-[#8d6a2f]">{t('Home-Profile-Label')}</p>
            <div
              class="mt-4 text-[length:var(--font-size-ui)] leading-relaxed text-primary-800"
              set:html={DOMPurify.sanitize(resume?.personalInfo.description || '')}
            ></div>
          </div>
        </div>
      </div>
    </Banner>

    <section class="mb-20 container mx-auto px-4">
      <div class="grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl border border-primary-200 bg-white p-5">
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Highlights-1-Title')}</p>
          <p class="mt-3 text-[length:var(--font-size-ui)] leading-relaxed text-primary-800">{t('Home-Highlights-1-Description')}</p>
        </div>
        <div class="rounded-2xl border border-primary-200 bg-white p-5">
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Highlights-2-Title')}</p>
          <p class="mt-3 text-[length:var(--font-size-ui)] leading-relaxed text-primary-800">{t('Home-Highlights-2-Description')}</p>
        </div>
        <div class="rounded-2xl border border-primary-200 bg-white p-5">
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Highlights-3-Title')}</p>
          <p class="mt-3 text-[length:var(--font-size-ui)] leading-relaxed text-primary-800">{t('Home-Highlights-3-Description')}</p>
        </div>
        <div class="rounded-2xl border border-primary-200 bg-white p-5">
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Highlights-4-Title')}</p>
          <p class="mt-3 text-[length:var(--font-size-ui)] leading-relaxed text-primary-800">{t('Home-Highlights-4-Description')}</p>
        </div>
      </div>
    </section>

    <section class="mb-24 container mx-auto px-4">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-8">
        <div>
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('NewestWork-1')}</p>
          <h2 class="text-[length:var(--font-size-display)] font-semibold mt-2 leading-tight">{t('Home-FeatureSection-Title')}</h2>
        </div>
        <a
          class="rounded-full border border-primary-300 px-5 py-3 hover:bg-primary-100 transition-colors"
          href={getLocalePath(Astro.currentLocale as LanguageKey || defaultLocale, '/work')}
        >
          {t('Home-FeatureSection-CTA')}
        </a>
      </div>

      <ul class="grid gap-6 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <li class="rounded-2xl border border-primary-200 bg-white p-5 md:p-6 shadow-[0_18px_60px_rgba(41,74,72,0.06)]">
            <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{project.data.publishDate.getFullYear()}</p>
            <h3 class="mt-3 text-[length:var(--font-size-title)] font-semibold leading-snug">{project.data.title}</h3>
            <p class="mt-4 text-[length:var(--font-size-ui)] leading-relaxed text-primary-700">{project.data.description}</p>
            <ul class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(7rem,1fr))] gap-2">
              {project.data.tech.map((tech) => (
                <li class="rounded-full bg-primary-100 px-3 py-1 text-center text-[length:var(--font-size-caption)] text-primary-700">{getTechLabel(tech, currentLocale)}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-4 container mx-auto px-4">
      <div class="grid gap-8 border-y border-primary-200 py-10 lg:grid-cols-[0.8fr_1.4fr]">
        <div>
          <p class="text-[length:var(--font-size-label)] uppercase tracking-[0.12em] text-primary-500">{t('Home-Outputs-Label')}</p>
          <h2 class="mt-2 max-w-3xl text-[length:var(--font-size-display)] font-semibold leading-tight text-primary-950">{t('Home-Outputs-Title')}</h2>
          <p class="mt-4 max-w-xl text-[length:var(--font-size-ui)] leading-relaxed text-primary-700">{t('Home-Outputs-Description')}</p>
        </div>
        <ul class="divide-y divide-primary-200">
          {outputLinks.map((output) => (
            <li>
              <a
                class="group grid gap-3 py-5 transition-colors hover:text-primary-950 sm:grid-cols-[1fr_auto] sm:items-start"
                href={output.url}
                target="_blank"
                rel="noreferrer"
              >
                <span>
                  <span class="block text-[length:var(--font-size-title)] font-semibold leading-snug text-primary-950">{output.title}</span>
                  <span class="mt-2 block text-[length:var(--font-size-ui)] leading-relaxed text-primary-700">{output.description}</span>
                </span>
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-primary-200 text-primary-600 transition-colors group-hover:border-primary-500 group-hover:bg-primary-50 group-hover:text-primary-900">
                  <Icon size={18} name="material-symbols:open-in-new-rounded" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>
